+    target_audience_fields:
+      - "age_range"
+      - "gender"
+      - "location"
+      - "interests"
+    age_range_default: "auto-detect from landing page when omitted"
+  budget_and_schedule_capture:
+    budget_fields:
+      - "monthly_budget"
+      - "daily_budget"
+      - "max_cpc"
+    landing_page_projection_budget_default_vnd: 10000000
+    schedule_defaults:
+      start_date: "today if blank"
+      end_date: "blank allowed"
+      day_parting: "24/7 if blank"
+      days_of_week: "Tất cả if blank"
+  campaign_goal_capture:
+    primary_goal_options:
+      - "Increase website traffic"
+      - "Increase conversions"
