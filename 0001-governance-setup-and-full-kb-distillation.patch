+      utm_source: "google"
+      utm_medium: "cpc"
+      utm_term: "{keyword}"
+  campaign_structure_templates:
+    campaign_type_options:
+      - "Search Campaign"
+      - "Display Campaign"
+      - "Shopping Campaign"
+      - "Video Campaign"
+      - "Performance Max"
+    ad_group_generation_rule: "create 1 ad group per main product using AG_{product_name_with_underscores}"
+    default_match_types: ["Exact", "Phrase", "Broad"]
+    bidding_strategy_options:
+      - "Manual CPC"
+      - "Enhanced CPC"
+      - "Maximize Clicks"
+      - "Target CPA"
+      - "Target ROAS"
+      - "Maximize Conversions"
+  phased_execution_playbook:
+    phase_1_setup:
+      - "Create/verify Google Ads account"
+      - "Install conversion tracking tag"
+      - "Link Google Analytics"
+      - "Setup billing"
+      - "Create initial campaign shell"
