+layout_strategy_types:
+  process_layout:
+    definition: "Group similar functions or machines together."
+    best_fit: "High variety, lower volume, make-to-order or functional service settings."
+    example: "Hospital departments such as X-ray, internal medicine, and surgery."
+    tradeoff: "High flexibility but higher internal movement cost and more complex flow control."
+  product_layout:
+    definition: "Arrange resources in the exact processing sequence of the product."
+    best_fit: "High-volume, standardized, repetitive production."
+    example: "Automobile assembly line."
+    tradeoff: "High throughput and low unit cost but low flexibility; one disrupted station affects the full line."
+  fixed_position_layout:
+    definition: "The product stays still while people, equipment, and materials move to it."
+    best_fit: "Large, heavy, or immovable outputs."
+    example: "Shipbuilding, construction projects, aircraft production."
+    tradeoff: "Necessary for large projects but costly to coordinate moving resources around the site."
+  cellular_layout:
+    definition: "Group machines into cells serving families of similar products."
+    best_fit: "Moderate variety with repeatable product families and group-technology logic."
+    example: "Component manufacturing with related part families."
+    tradeoff: "Balances flow efficiency and flexibility but requires more upfront analysis and redesign effort."
+  retail_service_layout_models:
+    grid_layout: "Maximizes display/storage density and supports easy product finding; typical in supermarkets."
+    free_flow_layout: "Encourages browsing and discovery at the cost of lower space efficiency; common in fashion retail."
+    loop_layout: "Guides customers through the full display path; classic IKEA-style circulation."
+    hot_zone_vs_cold_zone: "High-visibility zones should carry high-margin or launch items; destination essentials can pull traffic deeper into the store."
+    eye_level_selling: "Shelf positions around customer eye level receive higher product pick-up rates."
+
