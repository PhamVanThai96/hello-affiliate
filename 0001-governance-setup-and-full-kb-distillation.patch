+schema: "ai_distilled_knowledge_module_v1"
+module_id: "RE_MOD_02_ACTION_PLAYBOOK"
+domain: "DOM_RE"
+title: "Real Estate Action Playbook for Research, Capital Preparation, and Deal Execution"
+source_documents:
+  - "real-estate/ke-hoach-hanh-dong-bat-dong-san.md"
+
+objective_design_and_scope:
+  target_market:
+    geography: "Đà Nẵng"
+    asset_type: "Đất nền"
+    horizon: "12 months"
+  primary_outcomes:
+    completed_transactions: 2
+    target_profit_vnd: "200M"
+    target_local_network_size: 10
+    initial_capital_target_vnd: "500M"
+  first_deal_box:
+    acquisition_value_range_vnd: "800M-1.2B"
+    legal_standard: "Sổ đỏ chính chủ; pháp lý rõ ràng."
+    location_bias: ["Near major roads", "Near real infrastructure development", "Avoid peak pricing"]
+
+smart_goal_framework:
+  name_en: "SMART Goal Framework"
+  components: ["Specific", "Measurable", "Achievable", "Relevant", "Time-bound"]
+  application:
+    specific: "Complete 2 land-plot transactions in Đà Nẵng and build a 10-person operating network."
+    measurable: "2 transactions; 200M VND profit; 10 meaningful market relationships."
+    achievable: "Entry via small-to-mid ticket plots funded by salary, savings, and optional credit line."
+    relevant: "Aligned with long-term asset accumulation and rental/investment optionality."
+    time_bound: "Execution window = 12 months."
+
+phase_gated_execution_roadmap:
+  phase_1_learning_and_market_mapping:
+    duration: "Month 1-3"
+    objective: "Build operating literacy in legal, planning, pricing, and submarket structure."
+    workstreams:
+      knowledge_intake: ["Read 3 introductory real-estate books", "Study Land Law, Housing Law, transaction workflow"]
+      market_mapping: ["Research 5 Đà Nẵng districts", "Track daily asking prices and observed changes"]
+      fieldwork: ["Visit 20 live land projects or plots", "Capture price, infrastructure, and legal notes"]
+      information_channels: ["Join 2-3 local Facebook or Zalo groups", "Follow active listing portals daily"]
+    deliverables:
+      - "Analysis file for 5 promising Đà Nẵng zones."
+      - "List of 50 active projects or traded land areas with 3-month price observations."
+  phase_2_network_buildout:
+    duration: "Month 3-6"
+    objective: "Create local information advantage and transaction support capacity."
+    workstreams:
+      broker_sourcing: ["Contact 5 local brokers via Zalo, Facebook, or listing portals"]
+      event_attendance: ["Attend 3 offline real-estate events or meetups"]
+      relationship_building: ["Coffee or lunch with 10 brokers, investors, or land owners"]
+    deliverables:
+      - "List of 10 usable contacts with phone and Zalo."
+      - "At least 3 contacts willing to support first transaction."
+  phase_3_capital_preparation:
+    duration: "Month 3-6"
+    objective: "Prepare deployable equity and optional leverage capacity."
+    workstreams:
+      personal_finance_audit: ["Map assets", "Map liabilities", "Estimate borrowing capacity"]
+      savings_rule: ["Save 30% of monthly software-engineer income"]
+      banking_prep: ["Seek bank consultation on available credit line"]
+      capital_stack_completion: ["Target 300M cash + 200M credit if leverage is used"]
+    deliverables:
+      - "Deployable capital pool >= 500M VND."
+  phase_4_first_acquisition:
+    duration: "Month 7-9"
+    objective: "Close first acquisition with controlled legal and pricing risk."
+    workstreams:
+      asset_selection: ["Screen 5 candidate plots", "Analyze price, legal status, and planning"]
+      legal_due_diligence: ["Use real-estate lawyer for title and planning review"]
+      negotiation_and_closing: ["Negotiate terms", "Execute contract", "Transfer title"]
+    hard_filters:
+      - "Clear title and owner identity."
+      - "Independent planning verification before deposit."
+      - "No purchase above self-defined maximum price."
+    deliverables:
+      - "1 acquired land plot."
+  phase_5_disposition_and_second_cycle:
+    duration: "Month 10-12 and Month 1-3 of following year"
+    objective: "Attempt disposition of first asset when target price is reached and execute second buy-sell cycle."
+    workstreams:
+      market_monitoring: ["Track pricing and liquidity for first plot"]
+      sale_execution: ["List and sell first plot if return target is met"]
+      second_cycle: ["Run overlapping buy-sell process for second plot"]
+    target_profit_per_cycle_vnd: "100M-150M"
+    deliverables:
+      - "2 completed transaction cycles."
+      - "Total profit target = 200M VND."
+
+operating_routines_and_field_intelligence:
+  thirty_day_habit_system:
+    learning_block:
+      name_en: "Daily Learning Block"
+      components: ["Book reading", "Market video review", "Planning and policy news scan", "Note capture"]
+      cadence: "30 minutes per day"
+      objective: "Reduce knowledge-gap risk."
+    field_visit_block:
+      name_en: "Weekly Field Survey"
+      components: ["Site photos", "Road-width check", "Infrastructure observation", "3-5 broker price quotes", "Local resident inquiry", "Structured notes"]
+      cadence: "1 project per week; 2-3 hours each session"
+      observation_template:
+        project_name: "Text"
+        location: "Text"
+        quoted_price_vnd_per_m2: "Numeric field"
+        legal_status: ["Sổ đỏ", "Sổ hồng", "Giấy tay"]
+        infrastructure_checkboxes: ["Electricity", "Water", "Concrete Road"]
+        potential_score: "1-10"
+        notes: "Free text"
+    investment_journal:
+      name_en: "Daily Investment Journal"
+      components: ["What was learned today", "Who was contacted", "Progress toward 2-transaction goal", "One improvement for tomorrow"]
+      cadence: "10 minutes before sleep"
+
+network_and_environment_design:
+  high_value_relationship_stack:
+    mentor_or_successful_local_investor: "Monthly coffee; ask for deal filters and failure cases."
+    mastermind_group: "5-7 people; online meeting twice per month."
+    professional_broker: "Long-term information source for pricing and supply."
+    supportive_growth_peers: "Mutual accountability and opportunity sharing."
+    legal_and_tax_specialists: "Pay for quality review when needed."
+  low_signal_environment_filters:
+    entertainment_heavy_friend_group: "Reduce time if it displaces research or site visits."
+    salary_only_peer_pressure: "Do not use low-context opinions as investment decision input."
+    fear-driven_family_noise: "Acknowledge concern but keep decision process data-based."
+    rumor_groups: "Exit groups dominated by drama or unverified planning gossip."
+  environment_rebalance_plan:
+    week_1: "List 5 positive and 5 negative influence sources."
+    week_2_to_4: "Reduce unnecessary time with low-signal groups."
+    week_5_to_12: "Increase contact frequency with mentors, brokers, and serious investors."
+
+risk_controls_and_behavioral_guardrails:
+  capital_loss_controls:
+    - "Use lawyer-led legal due diligence before every transaction."
+    - "Buy only individually titled land; avoid giấy tay and unclear ownership."
+    - "Avoid concentrating 100% of capital in a single plot."
+    - "Maintain employment income as downside buffer during learning phase."
+  capability_gap_controls:
+    - "Front-load first 3 months into structured learning and site visits."
+    - "Use 2-3 experienced local mentors or advisors."
+    - "Keep first transaction small: under 1B VND preferred in raw plan."
+    - "Record observations after each survey to build proprietary evaluation criteria."
+  social_pressure_controls:
+    - "Do not disclose strategy to persistently negative audiences."
+    - "Prioritize advice from participants with actual local transaction experience."
+    - "Judge plan quality by process metrics and realized economics, not external approval."
+
+transaction_execution_protocol:
+  candidate_screening_sequence:
+    - "Select 5 potential plots."
+    - "Run price, legal, and planning analysis on each."
+    - "Shortlist only plots meeting title and infrastructure filters."
+    - "Negotiate only after independent due diligence is substantially complete."
+  negotiation_rules:
+    - "Use market evidence from comparable plots."
+    - "Prefer owner-direct or trusted-broker information."
+    - "Keep financing ceiling private during negotiation."
+  close_and_transfer_steps:
+    - "Sign deposit contract with explicit cancellation and tax clauses."
+    - "Notarize transfer contract."
+    - "Complete payment and title transfer."
+  exit_rules:
+    - "Sell first plot only when market price reaches pre-defined return threshold or capital rotation is superior."
+    - "Second cycle can overlap only if capital and risk buffer remain intact."
+
+scorecards_and_review_cadence:
+  weekly_review:
+    name_en: "Weekly Operating Review"
+    components: ["Learning days completed", "Project surveyed", "New industry contacts", "Savings progress", "Self-score 1-10"]
+    required_questions:
+      - "How many days did I study real estate this week? Target: 7/7."
+      - "Which project did I survey this week? Target: 1 project/week."
+      - "Who new did I connect with in the industry?"
+      - "How much capital have I saved toward 500M VND?"
+      - "What is my self-rating for this week?"
+  monthly_review:
+    tracked_metrics: ["Books or courses completed", "New relationships added", "Savings in VND"]
+    correction_rule: "If any metric < 70% of target, adjust next month's plan."
+  quarterly_review:
+    strategic_questions:
+      - "Do I still believe the target and timeline are realistic?"
+      - "Does the plan require more ambition or more caution?"
+      - "What are the 3 biggest lessons of the quarter?"
+      - "Which risks have decreased and which remain unresolved?"
+
+launch_checklist:
+  first_24_hours:
+    - "Block 30 minutes on next morning's calendar for real-estate study."
+    - "Choose the first book, legal summary, or district research topic."
+    - "Prepare a note system for site visits, contacts, and savings tracking."
+  first_7_days:
+    - "Join local investor or broker groups."
+    - "Identify first field-visit location."
