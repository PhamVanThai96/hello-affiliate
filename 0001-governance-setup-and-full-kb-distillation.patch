+      - "Enhanced CPC"
+      - "Maximize Clicks"
+      - "Target CPA"
+      - "Target ROAS"
+      - "Maximize Conversions"
+  phased_execution_playbook:
+    phase_1_setup:
+      - "Create/verify Google Ads account"
+      - "Install conversion tracking tag"
+      - "Link Google Analytics"
