+    long_term: "> 2 years; capacity, facility, and product-strategy decisions."
+  method_families:
+    qualitative: "Use expert judgment when history is weak or structural change dominates."
+    quantitative: "Use historical data when patterns are stable enough to model."
+  time_series_components:
+    trend: "Long-run upward or downward movement."
+    seasonality: "Pattern repeating at fixed intervals."
+    cyclical: "Longer economic-cycle movement without fixed periodicity."
+    random_irregular: "Residual noise from unpredictable events."
+    additive_model: "Y = T + S + C + R"
+    multiplicative_model: "Y = T * S * C * R"
+  moving_average:
+    formula: "MA_n = sum(recent_n_actual_values) / n"
+    tradeoff: "Larger n smooths noise more but reacts slower to real trend shifts."
+  weighted_moving_average:
+    formula: "WMA = sum(weight_i * actual_value_i), where sum(weight_i) = 1"
+    use_case: "Assign higher weight to recent observations when recency matters."
+  exponential_smoothing:
+    simple_formula: "F_t+1 = alpha * Y_t + (1 - alpha) * F_t"
+    alpha_tradeoff: "Higher alpha reacts faster but is noisier; lower alpha is smoother but slower."
+    holt_method: "Adds a trend component for data with clear upward or downward movement."
+    holt_winters_method: "Adds both trend and seasonality for recurring seasonal demand."
+  regression_analysis:
+    simple_linear_formula: "Y = a + bX"
+    slope_formula: "b = (n*sum(XY) - sum(X)*sum(Y)) / (n*sum(X^2) - (sum(X))^2)"
+    intercept_formula: "a = mean(Y) - b * mean(X)"
+    multiple_regression_formula: "Y = a + b1X1 + b2X2 + ... + bkXk"
+    r_squared: "Share of Y-variation explained by the regression model."
+  forecast_error_metrics:
+    mad: "MAD = sum(abs(Y_t - F_t)) / n"
+    mse: "MSE = sum((Y_t - F_t)^2) / n"
+    mape: "MAPE = (1/n) * sum(abs((Y_t - F_t) / Y_t)) * 100%"
+    bias: "Bias = sum(Y_t - F_t) / n"
+  tracking_signal:
+    formula: "TS = sum(Y_t - F_t) / MAD"
+    control_guideline: "A common warning threshold is outside +/- 4."
+  qualitative_and_collaborative_methods:
+    delphi_method: "Anonymous multi-round expert estimation until relative consensus emerges."
+    cpfr: "Collaborative Planning, Forecasting, and Replenishment shares forecast inputs across supply-chain partners."
+  advanced_forecasting_models:
+    arima: "ARIMA(p,d,q) handles autoregression, differencing, and moving-average error structure."
+    prophet: "Business-friendly model for multiple seasonalities, holidays, and missing/outlier-heavy data."
+    machine_learning: "Random Forest, XGBoost, and LSTM help when demand depends on many complex drivers."
+    alternative_data_inputs:
